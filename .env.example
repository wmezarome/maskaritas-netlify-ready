# Copy this file to ".env" for local testing, and enter the real values
# as Environment Variables inside the Netlify dashboard for production.
# NEVER commit a real ".env" file or paste real keys into the frontend code.
#
# See README.md → "Configurar Openpay" for full step-by-step instructions.

# Openpay by BBVA México — Merchant credentials
# Found in your Openpay dashboard under "Llaves API".
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=

# "sandbox" while testing, "production" only once real orders should be charged
OPENPAY_PRODUCTION_MODE=sandbox

# Optional: a hosted Openpay Payment Link, usable as a temporary checkout
# alternative before the full card-payment integration is turned on.
OPENPAY_PAYMENT_LINK_URL=
